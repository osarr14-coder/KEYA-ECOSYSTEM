DEBUG=True
SECRET_KEY=change-me-in-production

# Valeurs pour un Postgres natif local (voir CLAUDE.md — Docker Desktop
# nécessite WSL2, souvent indisponible sur les postes Windows de l'équipe).
# Avec docker-compose.yml, utiliser DB_HOST=localhost et DB_PORT=5433 à la
# place.
DB_NAME=keya_ecosystem_db
DB_USER=keya_ecosystem_app
DB_PASSWORD=keya_ecosystem_app_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Broker Celery — voir docs/adr/0001-celery-eager-mode.md.
# `docker run -d --name keyimmo-redis -p 6379:6379 redis:7-alpine`
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Une origine par app frontend en dev (ticket 020) : HOME 5173, BUILD 5174,
# CONTROL PWA 5175, apps/web (écran de connexion) 5176 — sans son port ici,
# une app frontend reçoit un 503 (préflight CORS bloqué) sur toute requête,
# jamais un message d'erreur clair côté navigateur.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# PO-2026-09-29-13 (T15) : antivirus ClamAV qui analyse chaque dépôt avant
# stockage (docs/adr/0006). Sans moteur joignable, TOUT dépôt est refusé.
# Poste Linux : `apt install clamav-daemon` (socket ci-dessous) ; Docker :
# `docker run -d --name keya-clamav -p 3310:3310 clamav/clamav:stable` puis
# KEYA_CLAMD_ADDRESS=localhost:3310. Contrôle : `manage.py check_upload_scan`.
KEYA_CLAMD_ADDRESS=unix:/var/run/clamav/clamd.ctl

# ADR 0004, PO-2026-09-30-08 : environnement du déploiement — DEMO, PILOTE ou
# PRODUCTION. OBLIGATOIRE : absent ou invalide, l'application refuse de démarrer.
KEYA_ENVIRONMENT=DEMO
# PO-2026-09-30-07 (dérogation T15) : en DÉMO seulement et sans moteur
# (KEYA_CLAMD_ADDRESS vide), dépôts acceptés sans antivirus, tracés, repassés
# au moteur plus tard (`manage.py rescan_unscanned_documents`). Refusé hors DÉMO.
# KEYA_DEMO_UPLOADS_WITHOUT_ANTIVIRUS=True
